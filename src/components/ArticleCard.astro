---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  contentType: "article" | "interview" | "misc";
  language: "sve" | "eng";
  tags?: string[];
}

const {
  href,
  title,
  description,
  pubDate,
  contentType,
  language,
  tags = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat("sv-SE", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
})
  .format(pubDate)
  .replace(".", "")
  .toUpperCase();
---

<a class="article-card" href={href}>
  <span class="article-card-icon" aria-hidden="true">
    <svg viewBox="0 0 48 48">
      <path d="M13 5.5h15l9 9v28H13z"></path>
      <path d="M28 5.5v10h9M19 23h12M19 30h12"></path>
    </svg>
  </span>
  <span class="article-card-content">
    <span class="article-card-title">{title}</span>
    <span class="article-card-description">{description}</span>
    <span class="article-card-meta">
      <span>{contentType}</span>
      <span class="meta-separator" aria-hidden="true">
        ·
      </span>
      <span>{language}</span>
      {(tags.length > 0 || language) && (
        <span class="meta-separator" aria-hidden="true">
          ·
        </span>
      )}
      {tags.length > 0 && (
        <span class="article-card-tags" aria-label="Tags">
          {tags.map((tag, index) => (
            <>
              {index > 0 && (
                <span class="meta-separator" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{tag}</span>
            </>
          ))}
        </span>
      )}
      {tags.length > 0 && (
        <span class="meta-separator" aria-hidden="true">
          ·
        </span>
      )}
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </span>
  </span>
  <span class="article-card-arrow" aria-hidden="true">
    <svg viewBox="0 0 32 24">
      <path d="M2 12h26M19 3l9 9-9 9"></path>
    </svg>
  </span>
</a>

<style>
  .article-card {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    min-width: 0;
    min-height: 13.75rem;
    padding: 1.5rem 0.5rem;
    border: 1px solid var(--color-border-card);
    border-radius: 0.9rem;
    text-decoration: none;
  }

  .article-card:hover {
    border-color: var(--color-accent);
    background-color: var(--background-color-interactive-hover);
  }

  .article-card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .article-card-icon {
    display: flex;
    justify-content: flex-start;
    padding-right: 0.5rem;
    border-right: 1px solid var(--color-border-card);
    color: var(--color-accent-strong);
  }

  .article-card-icon svg {
    width: 2.75rem;
    height: 2.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .article-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.65rem;
    min-width: 0;
  }

  .article-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.12;
  }

  .article-card-description {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .article-card-meta,
  .article-card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .article-card-meta {
    margin-top: auto;
    padding-top: 0.35rem;
    color: var(--color-accent-strong);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .meta-separator {
    font-size: 0.9em;
  }

  .article-card-arrow {
    display: flex;
    flex: 0 0 1.5rem;
    align-items: flex-end;
    color: var(--color-accent-strong);
  }

  .article-card-arrow svg {
    width: 1.5rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  @media (max-width: 760px) {
    .article-card {
      min-height: 11rem;
      gap: 0.9rem;
      padding: 1.25rem 1rem;
    }

    .article-card-icon {
      flex-basis: 3.25rem;
    }

    .article-card-icon svg {
      width: 2.25rem;
      height: 2.25rem;
    }

    .article-card-title {
      font-size: clamp(1.35rem, 5vw, 1.7rem);
    }

    .article-card-description {
      font-size: 0.9rem;
    }

    .article-card-arrow {
      flex-basis: 1.25rem;
    }

    .article-card-arrow svg {
      width: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card {
      transition: none;
    }

    .article-card:hover {
      transform: none;
    }
  }
</style>
