---
interface Props {
  quote: string;
  cite: string;
  citeUrl?: string;
  author: string;
}

const { quote, cite, citeUrl, author } = Astro.props;
---

<figure class="quote">
  <span class="quote-line" aria-hidden="true"></span>
  <div class="quote-inner">
    <blockquote cite={citeUrl}>
      <p>{quote}</p>
    </blockquote>
    <figcaption>
      — {author}, <cite>{cite}</cite>
    </figcaption>
  </div>
</figure>

<style>
  .quote {
    display: flex;
    margin: 0;
  }

  blockquote {
    margin: 0;
  }
  .quote-inner {
    margin: 1.5rem 0;
    padding-left: 1rem;
  }

  .quote-line {
    padding-left: 1.25rem;
    background-image: url("../assets/line-vertical.png");
    background-repeat: no-repeat;
    background-position: left center;
    background-size: 1rem 100%;
  }

  blockquote p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
</style>
