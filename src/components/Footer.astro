  <Line />
  <p>© {currentYear} Andrea Berglund</p>
</footer>

<style>
  footer {
    text-align: center;
    padding: 2rem;
    width: 100%;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
</style>
