---
const currentYear = new Date().getFullYear();
---

<footer>
  <p>© {currentYear} Andrea Berglund</p>
</footer>

<style>
  footer {
    text-align: center;
    padding: 1rem;
    width: 100%;
    height: auto;
    min-height: 300px;
    background: url("../assets/footer-blog.png");
    background-repeat: no-repeat;
    background-size: cover;
    background-position-x: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
  }

  @media (min-width: 901px) {
    footer {
      min-height: 400px;
    }
  }

  @media (min-width: 1200px) {
    footer {
      min-height: 450px;
    }
  }

  @media (min-width: 1350px) {
    footer {
      min-height: 500px;
    }
  }

  @media (min-width: 1450px) {
    footer {
      min-height: 550px;
    }
  }
</style>
