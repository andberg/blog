---
import Line from "./Line.astro";

const currentYear = new Date().getFullYear();
---

<footer>
  <Line />
  <section class="contact-card" aria-labelledby="contact-heading">
    <h2 id="contact-heading">The conversation continues.</h2>
    <p class="intro">
      Find me by email or explore my talks and conversations on YouTube.
    </p>

    <nav aria-label="Contact and other links">
      <a class="contact-link" href="mailto:andreaberglund@outlook.com">
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
        <span>Email</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        class="contact-link"
        href="https://www.linkedin.com/in/andreaberglund/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 9v10M5 5v.01M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"></path>
        </svg>
        <span>LinkedIn</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        class="contact-link"
        href="https://github.com/andberg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 19c-4 1.2-4-2-5-2.5m10 5v-3.1a2.7 2.7 0 0 0-.8-2.1c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 16.5 7a4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.5 11.5 0 0 0-6 0C4.8 3.5 3.8 3.8 3.8 3.8A4.3 4.3 0 0 0 3.7 7a4.7 4.7 0 0 0-1.2 3.3c0 4.7 2.8 5.7 5.5 6a2.7 2.7 0 0 0-.8 2.1V22"></path>
        </svg>
        <span>GitHub</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        class="contact-link"
        href="https://gitlab.com/AFandberg"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m3 8 4-4 5 4 5-4 4 4-9 12L3 8Z"></path>
          <path d="m3 8 9 4 9-4"></path>
        </svg>
        <span>GitLab</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        class="contact-link"
        href="https://sessionize.com/andrea-berglund/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="8" y="2" width="8" height="14" rx="4"></rect>
          <path d="M5 11a7 7 0 0 0 14 0M12 18v4m-4 0h8"></path>
        </svg>
        <span>My Sessionize Profile</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <a
        class="contact-link"
        href="https://youtube.com/playlist?list=PLdXyexBImquY&si=A19mKfGl_bEQdBq1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="4"></rect>
          <path d="m10 9 5 3-5 3z"></path>
        </svg>
        <span>Talks on YouTube</span>
        <svg class="external-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
    </nav>
  </section>
  <p class="copyright">© {currentYear} Andrea Berglund</p>
</footer>

<style>
  footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 2rem;
  }

  .contact-card {
    width: 100%;
    max-width: 900px;
    margin: 2rem auto 3rem;
  }

  h2 {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 600;
  }

  .intro {
    max-width: 60ch;
    margin: 1.25rem 0 2rem;
    font-size: 1rem;
  }

  nav {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 400px;
  }

  .contact-link {
    display: flex;
    flex-direction: row;
    align-items: center;

    gap: 1rem;
    min-height: 3rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--font-color-body);
    font-size: 1rem;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      padding 160ms ease;
  }

  .contact-link:first-child {
    border-top: 1px solid var(--color-border);
  }

  .contact-link:hover {
    background-color: var(--background-color-interactive-hover);
  }

  .contact-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .contact-icon,
  .external-icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .external-icon {
    width: 1.25rem;
    height: 1.25rem;
    justify-self: end;
  }

  .copyright {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 600px) {
    footer {
      padding: 1rem;
    }

    .contact-card {
      margin: 1.5rem auto 2rem;
    }

    .contact-link {
      min-height: 4.5rem;
      font-size: 1.05rem;
    }
  }
</style>
