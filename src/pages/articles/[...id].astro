---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
  getArticleRouteId,
  getSiblingArticleUrl,
} from "../../utils/article-url";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles
    .map((article) => ({
      article,
      routeId: getArticleRouteId(article.id, article.data.url),
    }))
    .filter(({ routeId }) => routeId.includes("/"))
    .map(({ article, routeId }) => ({
      params: { id: routeId },
      props: {
        article,
        swedishUrl:
          article.data.language === "eng"
            ? getSiblingArticleUrl(article, articles, "sve")
            : undefined,
      },
    }));
}

const { article, swedishUrl } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  language={article.data.language}
  swedishUrl={swedishUrl}
>
  <Content />
</ArticleLayout>
