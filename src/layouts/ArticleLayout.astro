---
import Layout from "./Layout.astro";

const { title, description, pubDate, language, swedishUrl } = Astro.props;
---

<Layout
  pageTitle={`${title} | Andrea Berglund`}
  description={description}
  lang={language === "sve" ? "sv" : "en"}
>
  <article>
    {language === "eng" && swedishUrl && (
      <a class="language-switch" href={swedishUrl}>
        På svenska
      </a>
    )}
    <h1>{title}</h1>
    <p class="ingress">{description}</p>
    <time datetime={pubDate.toISOString()}>
      {new Intl.DateTimeFormat("sv-SE", {
        dateStyle: "long",
        timeZone: "UTC",
      }).format(pubDate)}
    </time>
    <slot />
  </article>
</Layout>

<style>
  article {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .language-switch {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .ingress {
    font-size: 1.25rem;
  }

  time {
    display: block;
    margin-bottom: 2rem;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
  }

  article :global(pre) {
    overflow-x: auto;
  }

  p {
    max-width: 400ch;
  }
</style>
